{
  "name": "translink-dashboard-cards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src test *.json *.ts *.mjs",
    "build": "node build.mjs",
    "test:unit": "vitest run",
    "test:browser": "node test/browser/run.mjs",
    "check": "npm run typecheck && npm run format:check && npm run test:unit && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "lit": "3.3.3",
    "prettier": "3.8.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
