#!/bin/bash

# script/test: Run project tests
#
# Runs pytest with project configuration. Automatically cleans up package
# installations after test run to prevent Home Assistant from loading the
# wrong version.
#
# Usage:
#   ./script/test [OPTIONS] [PYTEST_OPTIONS]
#
# Options:
#   --cov           Generate coverage report (terminal output)
#   --cov-html      Generate HTML coverage report in htmlcov/
#
# Examples:
#   ./script/test
#   ./script/test -v
#   ./script/test --cov
#   ./script/test --cov-html
#   ./script/test --cov -k test_coordinator
#   ./script/test tests/test_api_wrapper.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# Pin the official plugin to the same release as Home Assistant.
TEST_PYTHON_VERSION="${TEST_PYTHON_VERSION:-3.14.2}"
TEST_HOME_ASSISTANT_VERSION="${TEST_HOME_ASSISTANT_VERSION:-2026.11.1}"
if [[ -n "${TEST_PLUGIN_VERSION:-}" ]]; then
    echo "TEST_PLUGIN_VERSION is obsolete: set TEST_HOME_ASSISTANT_VERSION for both packages." >&2
    exit 2
fi
if [[ ! "$TEST_PYTHON_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "TEST_PYTHON_VERSION must specify an exact Python version (major.minor.patch)." >&2
    exit 2
fi

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

if ! command -v uv >/dev/null 2>&1; then
    log_error "uv is required to provision the isolated test environment"
    log_info "Run: ./script/setup/bootstrap"
    exit 1
fi

if [[ -n "${TEST_VENV_PATH:-}" ]]; then
    :
elif [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" ]]; then
    TEST_VENV_PATH="$HOME/.local/ha-test-venv"
else
    TEST_VENV_PATH="$PWD/.local/ha-test-venv"
fi

log_header "Preparing isolated test environment"
uv python install "$TEST_PYTHON_VERSION"

CURRENT_TEST_PYTHON=""
if [[ -x "$TEST_VENV_PATH/bin/python3" ]]; then
    CURRENT_TEST_PYTHON=$("$TEST_VENV_PATH/bin/python3" -c "import platform; print(platform.python_version())" 2>/dev/null || true)
fi

if [[ ! -d "$TEST_VENV_PATH" ]]; then
    log_info "Creating test virtual environment at $TEST_VENV_PATH"
    uv venv --seed --python "$TEST_PYTHON_VERSION" "$TEST_VENV_PATH"
elif [[ "$CURRENT_TEST_PYTHON" != "$TEST_PYTHON_VERSION" ]]; then
    if [[ ! -f "$TEST_VENV_PATH/pyvenv.cfg" ]]; then
        log_error "$TEST_VENV_PATH exists but is not a virtual environment; refusing to delete it"
        exit 1
    fi
    log_info "Existing test venv uses Python ${CURRENT_TEST_PYTHON:-unknown} - recreating for Python $TEST_PYTHON_VERSION"
    rm -rf "$TEST_VENV_PATH"
    log_info "Creating test virtual environment at $TEST_VENV_PATH"
    uv venv --seed --python "$TEST_PYTHON_VERSION" "$TEST_VENV_PATH"
fi

# Keep the test environment aligned to the Home Assistant release bundled with
# the pytest plugin so local and CI runs resolve the same dependency set.
# shellcheck source=/dev/null
source "$TEST_VENV_PATH/bin/activate"

if uv pip show pytest-homeassistant-custom-component >/dev/null 2>&1; then
    uv pip uninstall pytest-homeassistant-custom-component
fi

log_info "Installing Home Assistant test dependencies"
uv pip install \
    . \
    "homeassistant==${TEST_HOME_ASSISTANT_VERSION}" \
    "pytest-homeassistant==${TEST_HOME_ASSISTANT_VERSION}" \
    "PyTurboJPEG>=2.2.0" \
    "av>=16.1.0" \
    "ha-ffmpeg>=3.2.2" \
    "segno==1.6.6" \
    "pytest>=8.0.0" \
    "pytest-asyncio>=0.23.0" \
    "pytest-cov>=4.0.0" \
    "pytest-timeout>=2.0.0"

python - <<'PY'
from importlib.metadata import PackageNotFoundError, version

try:
    version("pytest-homeassistant-custom-component")
except PackageNotFoundError:
    pass
else:
    raise SystemExit("Remove pytest-homeassistant-custom-component before running tests.")
if version("pytest-homeassistant") != version("homeassistant"):
    raise SystemExit("pytest-homeassistant must match the Home Assistant version.")
PY

# Parse coverage flags
COVERAGE_ARGS=()
PYTEST_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --cov)
            COVERAGE_ARGS+=("--cov=custom_components/translink" "--cov-report=term-missing")
            shift
            ;;
        --cov-html)
            COVERAGE_ARGS+=("--cov=custom_components/translink" "--cov-report=html")
            shift
            ;;
        *)
            PYTEST_ARGS+=("$1")
            shift
            ;;
    esac
done

# Ensure cleanup runs even when tests fail (set -e would exit before cleanup)
cleanup() {
    "$SCRIPT_DIR/clean" --minimal || true
}
trap cleanup EXIT

# Run pytest with project configuration
if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]]; then
    log_header "Running tests with coverage"
    echo ""
    pytest "${COVERAGE_ARGS[@]}" ${PYTEST_ARGS[@]+"${PYTEST_ARGS[@]}"}
else
    log_header "Running tests"
    echo ""
    pytest ${PYTEST_ARGS[@]+"${PYTEST_ARGS[@]}"}
fi


if [[ ${#COVERAGE_ARGS[@]} -gt 0 ]] && [[ " ${COVERAGE_ARGS[*]} " =~ " --cov-report=html " ]]; then
    echo ""
    log_success "Coverage report generated in htmlcov/index.html"
fi
