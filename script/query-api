#!/usr/bin/env python3
"""Query Translink Queensland API endpoints and GTFS-Realtime feeds.

Usage:
    ./script/query-api --search "Central"
    ./script/query-api --plan --start "Central" --end "Springfield"
    ./script/query-api --raw-plan 2026-11-11T13:00 ST:place_censta ST:place_kprsta
    ./script/query-api --trip-updates
    ./script/query-api --vehicles
"""

from __future__ import annotations

import argparse
import asyncio
import json
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

PUBLIC_CAPTURE_STATIONS = {
    "ST:place_censta": "Central station",
    "ST:place_kprsta": "Kippa-Ring station",
    "ST:place_forsta": "Fortitude Valley station",
    "ST:place_milsta": "Milton station",
}


def _compact(payload: Any) -> str:
    if payload is None:
        return "null"
    if hasattr(payload, "model_dump"):
        return json.dumps(payload.model_dump(mode="json"), indent=2, default=str)[:5000]
    return json.dumps(payload, indent=2, default=str)[:5000]


async def capture_raw_plan(target: datetime, start_id: str, end_id: str) -> int:
    """Capture a planner POST for fixed public stations without model validation."""
    import aiohttp

    from custom_components.translink.api.client import USER_AGENT, TranslinkClient

    request = TranslinkClient().build_plan_request(
        start_id,
        PUBLIC_CAPTURE_STATIONS[start_id],
        end_id,
        PUBLIC_CAPTURE_STATIONS[end_id],
        target_datetime=target,
    )
    try:
        async with (
            aiohttp.ClientSession(headers={"User-Agent": USER_AGENT}) as session,
            session.post(
                request.url,
                data=request.body,
                headers=request.headers,
                timeout=aiohttp.ClientTimeout(total=15),
                allow_redirects=False,
            ) as response,
        ):
            print(f"# Captured UTC: {datetime.now(UTC).isoformat()}")
            print(f"# Request URL: {request.url}")
            print(f"# Request ID: {request.request_id}")
            print(f"# Request body: {request.body}")
            print(f"# HTTP status: {response.status}")
            print(await response.text())
            return 0 if response.status == 200 else 1
    except (aiohttp.ClientError, TimeoutError, UnicodeError) as err:
        print(f"query-api failed: {err}", file=sys.stderr)
        return 1


async def run_query(args: argparse.Namespace) -> int:
    from custom_components.translink.client import TranslinkClient

    client = TranslinkClient()
    try:
        if args.search:
            print(f"# Location search: {args.search}")
            results = await client.search_locations(args.search)
            print(_compact([r.model_dump(mode="json") for r in results]))

        if args.plan:
            start = args.start or "Central"
            end = args.end or "Roma Street"
            print(f"# Planning journey: {start} -> {end}")
            locs_start = await client.search_locations(start)
            locs_end = await client.search_locations(end)
            if not locs_start or not locs_end:
                print("Could not resolve start or end location.")
                return 1
            plan = await client.plan_journey(
                start_location_id=locs_start[0].LocationId,
                start_name=locs_start[0].Description,
                end_location_id=locs_end[0].LocationId,
                end_name=locs_end[0].Description,
            )
            print(_compact(plan))

        if args.trip_updates:
            print("# Fetching GTFS-RT Trip Updates")
            tu = await client.fetch_trip_updates()
            print(f"Records: {len(tu)}")

        if args.vehicles:
            print("# Fetching GTFS-RT Vehicle Positions")
            positions = await client.fetch_vehicle_positions()
            print(f"Vehicle position records: {len(positions)}")

        return 0
    except Exception as err:
        print(f"query-api failed: {err}")
        return 1
    finally:
        await client.close()


def main() -> int:
    parser = argparse.ArgumentParser(description="Query Translink Queensland APIs")
    parser.add_argument("--search", help="Search for a stop, station, or landmark")
    parser.add_argument("--plan", action="store_true", help="Plan a journey")
    parser.add_argument("--start", help="Journey starting location name")
    parser.add_argument("--end", help="Journey destination name")
    parser.add_argument(
        "--raw-plan",
        nargs=3,
        metavar=("BRISBANE_DATETIME", "START_ID", "END_ID"),
        help=(
            "Capture raw planner data for a YYYY-MM-DDTHH:MM Brisbane time. "
            f"Public station IDs: {', '.join(PUBLIC_CAPTURE_STATIONS)}"
        ),
    )
    parser.add_argument(
        "--trip-updates", action="store_true", help="Fetch GTFS trip updates"
    )
    parser.add_argument(
        "--vehicles", action="store_true", help="Fetch GTFS vehicle positions"
    )
    args = parser.parse_args()

    if args.raw_plan:
        from custom_components.translink.const import BRISBANE_TZ

        if any(
            [
                args.search,
                args.plan,
                args.start,
                args.end,
                args.trip_updates,
                args.vehicles,
            ]
        ):
            parser.error("--raw-plan must be used on its own")
        target_text, start_id, end_id = args.raw_plan
        if (
            start_id not in PUBLIC_CAPTURE_STATIONS
            or end_id not in PUBLIC_CAPTURE_STATIONS
        ):
            parser.error(
                f"--raw-plan needs public station IDs from: {', '.join(PUBLIC_CAPTURE_STATIONS)}"
            )
        try:
            target = datetime.strptime(target_text, "%Y-%m-%dT%H:%M").replace(
                tzinfo=ZoneInfo(BRISBANE_TZ)
            )
        except ValueError:
            parser.error(
                "--raw-plan needs a Brisbane date and time in YYYY-MM-DDTHH:MM"
            )
        return asyncio.run(capture_raw_plan(target, start_id, end_id))

    if not any([args.search, args.plan, args.trip_updates, args.vehicles]):
        parser.print_help()
        return 0

    return asyncio.run(run_query(args))


if __name__ == "__main__":
    raise SystemExit(main())
